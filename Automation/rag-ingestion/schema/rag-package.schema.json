{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examnotespdf.in/schema/rag-package.schema.json",
  "title": "RAG package (schema_version 1)",
  "description": "Structural contract for a RAG ingestion package uploaded to rag/incoming/. See ../RAG_PACKAGE_SCHEMA.md for the human-readable version and the reasoning behind bounds. This file is used for documentation/structural reference; rag-package-validator.mjs implements the same rules directly (no external JSON-Schema-validator dependency, to stay dependency-light and offline per the repo's existing no-network-at-build-time convention).",
  "type": "object",
  "required": ["schema_version", "source", "chunks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1"]
    },
    "source": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "language": { "type": "string" },
        "origin": { "type": "string" }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "page": { "type": ["number", "null"] },
          "section": { "type": "string" },
          "topics": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "concepts": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      }
    }
  }
}
